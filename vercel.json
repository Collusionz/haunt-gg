{
  "version": 2,
  "builds": [
    { "src": "**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ],
  "cleanUrls": true,
  "headers": [
    { "source": "/bg.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }] },
    { "source": "/nav.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }] },
    { "source": "/player.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }] },
    { "source": "/guestbook.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }] },
    { "source": "/sync.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }] },
    { "source": "/analytics.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }] }
  ]
}