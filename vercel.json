{
  "version": 2,
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/valorant", "dest": "/valorant.html" },
    { "src": "/widgets", "dest": "/widgets.html" },
    { "src": "/projects", "dest": "/projects.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
